{
  "schemaVersion": 1,
  "id": "carryon",
  "version": "${version}",
  "name": "CarryOn",
  "description": "Server side only CarryOn mod\n更好的启动页面",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/carryon/icon.png",
  "environment": "server",
  "entrypoints": {
    "fabric-datagen": [
      "io.ula.carryon.client.MainDataGenerator"
    ],
    "main": [
      "io.ula.carryon.Main"
    ]
  },
  "mixins": [
    "carryon.mixins.json",
    {
      "config": "carryon.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
